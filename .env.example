# Google Gemini API Key (Required for LLM generation)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (defaults to gemini-3.6-flash)
# Options: gemini-3.6-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.6-flash
